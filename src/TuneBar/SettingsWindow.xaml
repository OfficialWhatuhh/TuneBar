<Window x:Class="TuneBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuneBar Settings"
        Width="520" Height="700" MinHeight="400"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/TuneBar.ico"
        Background="#1B1B1B"
        Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#262626" />
        <SolidColorBrush x:Key="CardEdge" Color="#333333" />
        <SolidColorBrush x:Key="Muted" Color="#A6FFFFFF" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- On/off switch -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10"
                                    Background="Transparent" BorderBrush="#99FFFFFF" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0"
                                         HorizontalAlignment="Left" Fill="#CCFFFFFF" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource PlayGlyphBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-shaped choice buttons -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,6"
                                Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Padding" Value="11,5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color dot -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"
                                     Stroke="#40FFFFFF" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Stroke" Value="White" />
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="Width" Value="96" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#14FFFFFF" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Height="30">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,0" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider pieces -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="White" Stroke="#40000000" StrokeThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Image Source="Assets/TuneBar.png" Width="40" Height="40" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TuneBar" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Changes apply right away." Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>

                <!-- General -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource CardTitle}" />
                        <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}"
                                  Content="Start TuneBar when Windows starts"
                                  Click="StartupToggle_Click" />
                        <CheckBox x:Name="AnyPlayerToggle" Style="{StaticResource Toggle}"
                                  Content="Also show other players (browser, YouTube...)"
                                  Click="AnyPlayerToggle_Click" />
                    </StackPanel>
                </Border>

                <!-- Position -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Position" Style="{StaticResource CardTitle}" />
                        <WrapPanel>
                            <RadioButton x:Name="InTaskbarRadio" Style="{StaticResource Chip}" GroupName="Pos"
                                         Content="Inside the taskbar" Click="Position_Click" />
                            <RadioButton x:Name="AboveRadio" Style="{StaticResource Chip}" GroupName="Pos"
                                         Content="Floating above the taskbar" Click="Position_Click" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Inside the taskbar, TuneBar hides and shows together with an auto-hiding taskbar." />

                        <CheckBox x:Name="AutoFitToggle" Style="{StaticResource Toggle}" Margin="0,12,0,0"
                                  Content="Fit automatically between the weather button and Start"
                                  Click="AutoFitToggle_Click" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Works with centered taskbar icons on Windows 11. Dragging the widget turns this off." />

                        <TextBlock x:Name="OffsetLabel" Text="Distance from the left edge" Style="{StaticResource Label}" />
                        <Slider x:Name="OffsetSlider" Style="{StaticResource ModernSlider}"
                                Minimum="0" Maximum="1500" ValueChanged="OffsetSlider_ValueChanged" />

                        <TextBlock x:Name="WidthLabel" Text="Width" Style="{StaticResource Label}" />
                        <Slider x:Name="WidthSlider" Style="{StaticResource ModernSlider}"
                                Minimum="280" Maximum="600" ValueChanged="WidthSlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- Colors -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Colors" Style="{StaticResource CardTitle}" />

                        <TextBlock Text="Background" Margin="0,0,0,6" />
                        <WrapPanel>
                            <RadioButton x:Name="BgAuto" Style="{StaticResource Chip}" GroupName="Bg" Tag="Auto"
                                         Content="Match Windows" Click="BgMode_Click" />
                            <RadioButton x:Name="BgDark" Style="{StaticResource Chip}" GroupName="Bg" Tag="Dark"
                                         Content="Dark" Click="BgMode_Click" />
                            <RadioButton x:Name="BgLight" Style="{StaticResource Chip}" GroupName="Bg" Tag="Light"
                                         Content="Light" Click="BgMode_Click" />
                            <RadioButton x:Name="BgCustom" Style="{StaticResource Chip}" GroupName="Bg" Tag="Custom"
                                         Content="Custom" Click="BgMode_Click" />
                        </WrapPanel>
                        <WrapPanel x:Name="BgSwatches" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                            <TextBox x:Name="BgHexBox" Style="{StaticResource HexBox}"
                                     LostFocus="BgHexBox_Commit" KeyDown="HexBox_KeyDown" />
                        </StackPanel>

                        <TextBlock x:Name="OpacityLabel" Text="Background opacity" Style="{StaticResource Label}" />
                        <Slider x:Name="OpacitySlider" Style="{StaticResource ModernSlider}"
                                Minimum="0" Maximum="100" ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="0% blends right into your taskbar. Turn it up for a solid pill." />

                        <TextBlock Text="Accent (play button and volume bar)" Margin="0,16,0,6" />
                        <WrapPanel x:Name="AccentSwatches" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                            <TextBox x:Name="AccentHexBox" Style="{StaticResource HexBox}"
                                     LostFocus="AccentHexBox_Commit" KeyDown="HexBox_KeyDown" />
                        </StackPanel>
                        <CheckBox x:Name="ArtAccentToggle" Style="{StaticResource Toggle}" Margin="0,12,0,0"
                                  Content="Match the album art color" Click="ArtAccentToggle_Click" />

                        <Button Content="Reset colors" Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetColors_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource FlatButton}"
                        MinWidth="80" Click="Done_Click" />
                <Button DockPanel.Dock="Left" Content="Exit TuneBar" Style="{StaticResource FlatButton}"
                        Click="Exit_Click" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
