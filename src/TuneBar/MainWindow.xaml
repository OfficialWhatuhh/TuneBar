<Window x:Class="TuneBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuneBar"
        Width="380" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseWheel="Window_MouseWheel">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Flat round-cornered icon button (previous / next / mute) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round play / pause button -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PlayGlyphBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Circle" Width="28" Height="28" Fill="{DynamicResource AccentBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            Margin="4"
            Padding="4,0,8,0"
            CornerRadius="6"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseLeftButtonUp"
            LostMouseCapture="Root_LostMouseCapture">

        <Border.ContextMenu>
            <ContextMenu x:Name="Menu" Opened="Menu_Opened" Closed="Menu_Closed">
                <MenuItem Header="Settings..." FontWeight="SemiBold" Click="MiSettings_Click" />
                <MenuItem Header="Open Spotify" Click="MiOpenSpotify_Click" />
                <Separator />
                <MenuItem Header="Exit TuneBar" Click="MiExit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Album art -->
            <Border x:Name="ArtBorder" Grid.Column="0"
                    Width="32" Height="32" CornerRadius="4"
                    Background="{DynamicResource ArtPlaceholderBrush}"
                    VerticalAlignment="Center" Cursor="Hand">
                <Grid>
                    <TextBlock x:Name="ArtGlyph" Text="&#xE8D6;"
                               FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource SubFgBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="ArtImage" CornerRadius="4" />
                </Grid>
            </Border>

            <!-- Song + artist -->
            <StackPanel x:Name="InfoPanel" Grid.Column="1" Margin="8,0,6,0"
                        VerticalAlignment="Center" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="Spotify isn't playing"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource FgBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Text="Click to open Spotify"
                           FontSize="11" Margin="0,1,0,0"
                           Foreground="{DynamicResource SubFgBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Previous / Play-Pause / Next -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Style="{StaticResource IconButton}"
                        Content="&#xE892;" ToolTip="Previous" Click="Prev_Click" />
                <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="2,0"
                        Content="&#xE768;" ToolTip="Play" Click="Play_Click" />
                <Button x:Name="NextButton" Style="{StaticResource IconButton}"
                        Content="&#xE893;" ToolTip="Next" Click="Next_Click" />
            </StackPanel>

            <!-- Volume -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" FontSize="13"
                        Content="&#xE995;" ToolTip="Mute" Click="Mute_Click" />
                <Grid x:Name="VolumeBar" Width="70" Height="22" Margin="2,0,0,0"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="VolumeBar_MouseLeftButtonDown"
                      MouseMove="VolumeBar_MouseMove"
                      MouseLeftButtonUp="VolumeBar_MouseLeftButtonUp"
                      LostMouseCapture="VolumeBar_LostMouseCapture">
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                            Background="{DynamicResource TrackBrush}" />
                    <Border x:Name="VolumeFill" Height="4" CornerRadius="2" Width="35"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}" />
                    <Ellipse x:Name="VolumeThumb" Width="10" Height="10" Margin="30,0,0,0"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Fill="{DynamicResource FgBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
