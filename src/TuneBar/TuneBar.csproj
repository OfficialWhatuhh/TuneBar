<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TuneBar</AssemblyName>
    <RootNamespace>TuneBar</RootNamespace>
    <ApplicationIcon>Assets\TuneBar.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Product>TuneBar</Product>
    <Description>A tiny Spotify mini-player that lives on your Windows taskbar.</Description>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used only for per-app (Spotify) volume via Windows Core Audio. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\TuneBar.ico" />
    <Resource Include="Assets\TuneBar.png" />
  </ItemGroup>

</Project>
